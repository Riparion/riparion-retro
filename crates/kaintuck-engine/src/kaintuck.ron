// Kaintuck — the data-driven scenario. A faithful port of the hand-written
// content/flow that used to live in the engine source. Stage 1 covers the
// static tables (goods, boats, towns, stands, pace economy, scoring, endings);
// hazard structure, branching outcomes, and set-pieces are layered on later.
//
// Numbers here mirror the old `const`s exactly and are guarded by the
// `scenario_matches_legacy_consts` test — do not retune without intent.
Scenario(
    goods: [
        (name: "Corn",      units: 1),
        (name: "Whiskey",   units: 1),
        (name: "Flour",     units: 1),
        (name: "Tobacco",   units: 1),
        (name: "Pork",      units: 1),
        (name: "Hides",     units: 1),
        (name: "Livestock", units: 2),
    ],

    boats: [
        (label: "Skiff",     cost: 40.0,  capacity: 30,  draft: 0.7, lumber_value: 25.0, hint: "cheap, light, shallow — small load"),
        (label: "Flatboat",  cost: 75.0,  capacity: 60,  draft: 1.0, lumber_value: 55.0, hint: "the workhorse of the river"),
        (label: "Broadhorn", cost: 130.0, capacity: 100, draft: 1.4, lumber_value: 95.0, hint: "hauls a fortune — and draws deep water"),
    ],

    start: (
        cash: 50.0,
        credit_cap: 200.0,
        crew_wage: 3.0,
        provisions: 50.0,
        // Every quote carries an 8% bid/ask spread (buy 4% over the mid, sell 4%
        // under); a town's market entries widen it on thin or contested goods.
        base_spread: 0.08,
        // Boatyard debt grows 5% a leg at a neutral name; reputation swings the
        // charged rate ±half that. Cincinnati/Memphis offer credit at twice cash
        // (before reputation scaling), never below the flat credit_cap floor.
        base_interest: 0.05,
        credit_multiple: 2.0,
    ),

    river: (
        river_miles: 1830.0,
        towns: [
            (name: "Pittsburgh",  slug: "pittsburgh",  milepost: 0.0,    base_ranks: [2, 8,  4, 6,  5,  7,  12], moneylender: false,
                // Head of the trade: Monongahela rye off the valley stills, and
                // the first flour barrels of the Ohio country.
                market: [
                    (good: "Whiskey", supply: 0.30, note: Some("Monongahela rye, straight from the valley stills")),
                    (good: "Flour",   supply: 0.12),
                ]),
            (name: "Wheeling",    slug: "wheeling",    milepost: 90.0,   base_ranks: [2, 10, 4, 7,  6,  7,  11], moneylender: false,
                market: [
                    (good: "Flour", supply: 0.12, note: Some("Wheeling's mills never stop")),
                ],
                // Upper Ohio: the first hundred miles are one long string of
                // riffles and bars (the sandbar arm 1 widened to 18%); piracy
                // this far up is near nil (arm 3 trimmed to 3%).
                hazards: Some((
                    thresholds: [18.0, 26.0, 29.0, 37.0, 45.0, 52.0],
                    grouped_thins: [3],
                    arms: [
                        Clean(message: Some("The current carries you down a long staircase of riffles — the boatmen's word for the broken water that frets over the bars.")),
                        Minigame(outcome: "sandbar", message: Some("The first hundred miles of the Ohio are so full of bars a careless pilot grounds a dozen times a day. One reaches out for you now.")),
                        Minigame(outcome: "patch"),
                        Minigame(outcome: "pirates", message: Some("River pirates pull alongside!"), cover: Some("pirates")),
                        Special("spoilage"),
                        Special("crew-grumble"),
                        Minigame(outcome: "bail"),
                    ],
                ))),
            (name: "Marietta",    slug: "marietta",    milepost: 170.0,  base_ranks: [2, 11, 5, 8,  6,  7,  13], moneylender: false,
                market: [
                    (good: "Corn", supply: 0.12, note: Some("the Ohio Company's bottomland corn")),
                ],
                // Still the upper Ohio — riffles and bars, with Letart's Rapids
                // on the reach above (a touch more bail). Piracy still slight.
                hazards: Some((
                    thresholds: [16.0, 24.0, 27.0, 35.0, 43.0, 52.0],
                    grouped_thins: [3],
                    arms: [
                        Clean(message: Some("Quiet water, but for the riffles breaking over the bars and the warping-tackle left standing at Letart's Rapids upstream.")),
                        Minigame(outcome: "sandbar", message: Some("A bar reaches out from the head of an island — the kind the Navigator numbers by the score on this reach.")),
                        Minigame(outcome: "patch"),
                        Minigame(outcome: "pirates", message: Some("River pirates pull alongside!"), cover: Some("pirates")),
                        Special("spoilage"),
                        Special("crew-grumble"),
                        Minigame(outcome: "bail"),
                    ],
                ))),
            (name: "Maysville",   slug: "maysville",   milepost: 410.0,  base_ranks: [3, 12, 5, 8,  7,  8,  15], moneylender: false,
                // The Kentucky bluffs: burley tobacco and droves of livestock
                // come down to the landing here.
                market: [
                    (good: "Tobacco",   supply: 0.25, note: Some("burley cured in the Kentucky bluffs")),
                    (good: "Livestock", supply: 0.15),
                ]),
            (name: "Cincinnati",  slug: "cincinnati",  milepost: 470.0,  base_ranks: [3, 13, 6, 9,  7,  8,  17], moneylender: true,
                // Porkopolis: the packing houses glut the wharf with cheap pork,
                // while the tanneries bid up every hide that comes downriver.
                market: [
                    (good: "Pork",  supply: 0.30, note: Some("Porkopolis, where the packing houses glut the wharf")),
                    (good: "Hides", demand: 0.15, spread: 0.10, note: Some("the tanneries are hungry for them")),
                ]),
            (name: "Louisville",  slug: "louisville",  milepost: 600.0,  base_ranks: [3, 14, 6, 10, 8,  9,  18], moneylender: false,
                // At the Falls: Kentucky bourbon barreled above the rapids, and
                // more of the burley leaf.
                market: [
                    (good: "Whiskey", supply: 0.18, note: Some("Kentucky bourbon, barreled above the Falls")),
                    (good: "Tobacco", supply: 0.15),
                ]),
            (name: "Shawneetown", slug: "shawneetown", milepost: 850.0,  base_ranks: [3, 14, 6, 11, 8,  9,  18], moneylender: false,
                // A salt-works town on the lower Ohio that grows little of its
                // own — it buys provisions off the river, at a wide spread.
                market: [
                    (good: "Flour", demand: 0.12, spread: 0.10, note: Some("a salt town that grows little of its own")),
                    (good: "Pork",  demand: 0.10, spread: 0.10),
                ],
                // Lower Ohio: the snags begin — planters and sawyers fixed in the
                // bottom (the patch arm 2 widened to 17%), and the first whiff of
                // the piracy that thickens toward Cave-in-Rock.
                hazards: Some((
                    thresholds: [9.0, 26.0, 33.0, 41.0, 48.0, 56.0],
                    grouped_thins: [3],
                    arms: [
                        Clean(message: Some("The lower Ohio runs broad and brown. Floating logs — the boatmen call the worst of them planters and sawyers — slide past on the current.")),
                        Minigame(outcome: "sandbar"),
                        Minigame(outcome: "patch", message: Some("A sawyer — a sunken log with its free end bobbing in the current — heaves up under the bow and stoves a plank.")),
                        Minigame(outcome: "pirates", message: Some("River pirates pull alongside!"), cover: Some("pirates")),
                        Special("spoilage"),
                        Special("crew-grumble"),
                        Minigame(outcome: "bail"),
                    ],
                ))),
            (name: "Cairo",       slug: "cairo",       milepost: 980.0,  base_ranks: [3, 15, 6, 11, 8,  10, 19], moneylender: false,
                market: [
                    (good: "Flour", demand: 0.12, spread: 0.12, note: Some("a half-built landing in the swamp, fed by the river")),
                ],
                // The mouth of the Ohio: the two currents collide into "boils" —
                // irregular water that can swamp a boat (the bail arm 6 up to
                // 11%). The Cave-in-Rock relay-pilot set-piece carries the piracy
                // here, so the pirate arm stays modest.
                hazards: Some((
                    thresholds: [12.0, 22.0, 28.0, 36.0, 44.0, 55.0],
                    grouped_thins: [3],
                    arms: [
                        Clean(message: Some("Where the Ohio pours into the Mississippi the waters fight and throw up boils — patches of river that heave and turn without warning.")),
                        Minigame(outcome: "sandbar", message: Some("A bar builds where the two rivers meet, shifting with every rise. You feel her touch it.")),
                        Minigame(outcome: "patch"),
                        Minigame(outcome: "pirates", message: Some("River pirates pull alongside!"), cover: Some("pirates")),
                        Special("spoilage"),
                        Special("crew-grumble"),
                        Minigame(outcome: "bail", message: Some("A boil takes her broadside and the river comes over the gunwale — bail, before she fills!")),
                    ],
                ))),
            (name: "Grand Tower", slug: "grand-tower", milepost: 1010.0, base_ranks: [3, 16, 6, 11, 9,  10, 19], moneylender: false,
                market: [
                    (good: "Pork", demand: 0.10, spread: 0.12),
                ],
                // The Grand Chain of the Mississippi: thirty miles of rock — the
                // Devil's Bake Oven, the Devil's Anvil and Backbone — where boats
                // must land and cordelle through, and where the gangs lay in
                // wait. Pirates (arm 3) widen to 14%, the rock-snag patch to 12%.
                // A top band (56,64] forces the cordelle haul itself (arm 7) at 8%.
                hazards: Some((
                    thresholds: [10.0, 22.0, 36.0, 42.0, 48.0, 56.0, 64.0],
                    grouped_thins: [3],
                    arms: [
                        Clean(message: Some("The river boils against the Devil's Bake Oven and hurls itself at the Grand Tower opposite. You thread the Grand Chain and run clear.")),
                        Minigame(outcome: "sandbar"),
                        Minigame(outcome: "patch", message: Some("The current drives you onto the Cornice Rocks — the Devil's Anvil — and a ledge tears at the hull.")),
                        Minigame(outcome: "pirates", message: Some("Where the rapids force every boat to land and cordelle, men step out of the rocks to rob you — draw!"), cover: Some("pirates")),
                        Special("spoilage"),
                        Special("crew-grumble"),
                        Minigame(outcome: "bail"),
                        Minigame(outcome: "cordelle", message: Some("The current runs too hard against the rocks to drift the Grand Chain — there's nothing for it but to land and cordelle her up by hand.")),
                    ],
                ))),
            (name: "Memphis",     slug: "memphis",     milepost: 1430.0, base_ranks: [3, 16, 6, 11, 9,  11, 19], moneylender: true,
                // A young bluff town buying what floats down — provisions go dear.
                market: [
                    (good: "Flour", demand: 0.12, spread: 0.10, note: Some("a young bluff town buying what floats down")),
                    (good: "Corn",  demand: 0.10, spread: 0.10),
                ],
                // The Chickasaw Bluffs: the Mississippi gathers into great basin
                // eddies below the bluffs (the sandbar arm carries the whirl).
                hazards: Some((
                    thresholds: [15.0, 25.0, 33.0, 41.0, 48.0, 56.0],
                    grouped_thins: [3],
                    arms: [
                        Clean(message: Some("Below the Chickasaw Bluffs the river draws into a slow, basin-shaped eddy and turns the boat lazily round before letting her go.")),
                        Minigame(outcome: "sandbar", message: Some("A basin eddy off the bluffs catches her and whirls her toward the bar at its rim — hold her off!")),
                        Minigame(outcome: "patch"),
                        Minigame(outcome: "pirates", message: Some("River pirates pull alongside!"), cover: Some("pirates")),
                        Special("spoilage"),
                        Special("crew-grumble"),
                        Minigame(outcome: "bail"),
                    ],
                ))),
            (name: "Natchez",     slug: "natchez",     milepost: 1830.0, base_ranks: [4, 21, 8, 14, 11, 15, 18], moneylender: false,
                // The lower river (Cave-in-Rock down toward Natchez) was the
                // piracy gauntlet. The pirate arm is arms[3], whose band is
                // (thresholds[1], thresholds[2]]: this override widens it from
                // (20,30] = 10% to (14,44] = 30%, trimming the other minor arms.
                // A new top band (60,64] adds the counterfeit con (arm 7) at 4%,
                // the trade of the Stack Island gangs on this lower water; the
                // clean residual above it is 36%. The pirate arm stays arms[3].
                hazards: Some((
                    thresholds: [8.0, 14.0, 44.0, 50.0, 55.0, 60.0, 64.0],
                    // Sailing in company draws off the pirates (arm 3) on the
                    // lower river — half the time it converts to a clean leg.
                    grouped_thins: [3],
                    arms: [
                        Clean(message: Some("The current carries you on, but every snag on the bank looks like a hidden skiff.")),
                        Minigame(outcome: "sandbar", message: Some("The river bends hard at the Devil's Elbow and a bar reaches out from the point.")),
                        Minigame(outcome: "patch"),
                        Minigame(outcome: "pirates", message: Some("River pirates pull alongside!"), cover: Some("pirates")),
                        Special("spoilage"),
                        Special("crew-grumble"),
                        Minigame(outcome: "bail"),
                        Special("counterfeit"),
                    ],
                ))),
        ],
        // arms[0] is a clean leg; arms[1..] line up with the thresholds above.
        hazards: (
            thresholds: [10.0, 20.0, 30.0, 42.0, 52.0, 60.0],
            // A convoy thins river pirates (arm 3), as on the lower-river table.
            grouped_thins: [3],
            arms: [
                Clean(message: Some("The current carries you on. A quiet stretch of river.")),
                Minigame(outcome: "sandbar"),
                Minigame(outcome: "patch"),
                Minigame(outcome: "pirates", message: Some("River pirates pull alongside!"), cover: Some("pirates")),
                Special("spoilage"),
                Special("crew-grumble"),
                Minigame(outcome: "bail"),
            ],
        ),
    ),

    trace: (
        total_miles: 450.0,
        max_days: 40,
        divide_at: 423.9,
        duck_river_at: 440.0,
        horse_multiplier: 1.6,
        paces: [
            (label: "Steady", miles_per_day: 14.0, provisions_cost: 4.0, health_cost: 1.0),
            (label: "Hard",   miles_per_day: 20.0, provisions_cost: 6.0, health_cost: 4.0),
        ],
        stands: [
            (label: "Mount Locust",            key: "mount-locust",  milepost: 15.5,  kind: Rest,          flavor: "The first inn north of Natchez. A meal of corn mush and a place on the porch."),
            (label: "The Choctaw Territory",   key: "choctaw",       milepost: 120.0, kind: Rest,          flavor: "Deep in Choctaw country, the forest closes in. Rest while you can."),
            (label: "Buzzard Roost Spring",    key: "buzzard-roost", milepost: 320.3, kind: Rest,          flavor: "A prosperous Chickasaw stand. They keep travelers fed, safe — and coming back."),
            (label: "Tennessee Valley Divide", key: "tn-divide",     milepost: 423.9, kind: Rest,          flavor: "The Tennessee Valley Divide — the old border. Harpe country lies north."),
            (label: "Duck River Crossing",     key: "duck-river",    milepost: 440.0, kind: RiverCrossing, flavor: "The Duck River crossing."),
        ],
        // arms[0] is a clean day; travelling in company thins the bandit
        // ambushes (arms 1 and 2). Arm 2 is the Harpes past the divide, the
        // swamp fever before it. A top band (50,56] is the chance to hunt for the
        // pot (arm 6) — a positive event, so it is not thinned by company.
        //
        // Band widths set the hazard mix. The Trace leans toward outlaws over
        // sickness: the Mason ambush (arm 1) gets a wide 14% band while the
        // swamp-fever dose (arm 3) is held to 6% and the mud crossing (arm 5) to
        // 14% — clean stays 44%, so the road is no deadlier overall, just more
        // lawless than feverish.
        hazards: (
            thresholds: [14.0, 22.0, 28.0, 36.0, 50.0, 56.0],
            grouped_thins: [1, 2],
            arms: [
                Clean(),
                Minigame(outcome: "mason"),
                Branch(
                    past_divide: Minigame(outcome: "harpe"),
                    before: Minigame(outcome: "dose"),
                ),
                Minigame(outcome: "dose"),
                Minigame(outcome: "side-trail"),
                Minigame(outcome: "swamp"),
                Minigame(outcome: "trace-hunt", message: Some("Provisions are running thin — but there's game stirring in the canebrake along the Trace.")),
            ],
        ),
    ),

    scoring: (
        base_win: 1500.0,
        crew_bonus: 75.0,
        rep_mult: 4.0,
        rep_floor: -100.0,
        robbed_penalty: -300.0,
        speed_par_days: 35,
        speed_per_day: 20.0,
        loss_miles_div: 4.0,
        loss_leftover_div: 4.0,
        ranks: [
            (min: 5000, name: "River King"),
            (min: 3500, name: "Master Kaintuck"),
            (min: 2000, name: "Trader"),
            (min: 900,  name: "Boatman"),
            (min: 1,    name: "Greenhorn"),
        ],
        floor_rank: "Drowned Rat",
    ),

    setpieces: (
        ferry_toll: 6.0,
        rest_provisions: 30.0,
        rest_health: 10.0,
        falls_pilot_msg: "A falls pilot takes the steering oar and threads you down the two-mile chute, clean.",
        ferry_cross_msg: "Colbert's hands pole you across, dry and whole. A dollar a head, and he clears a fortune on this crossing alone.",
        duck_horse_msg: "You reach the Duck River. Astride your horse you pick a line through the current and cross without much trouble.",
        ferry_late_days: 1,
        ferry_late_msg: "You reach Colbert's ferry after the hands have bedded down. They're a contrary lot and won't pole you over till daylight — a day lost on the bank.",
    ),

    // The buttons each set-piece screen shows. Gates hide an option until its
    // condition holds; `affordable_only` disables (rather than hides) when the
    // purse is short. `{cost}` in a label is filled with the formatted cost.
    menus: (
        falls: (options: [
            (label: "Hire a falls pilot — {cost}", hint: "A local takes the oar and threads you down. A sure thing.", cost: 8.0, action: "falls-pilot"),
            (label: "Run the falls yourself",       hint: "Free — but the current is violent. Hold your line.", primary: true, action: "falls-run"),
            (label: "Wait for high water",          hint: "Safe passage, but it costs days and frays the crew.", action: "falls-wait"),
        ]),
        grandtower: (options: [
            (label: "Stand a treat — {cost}", hint: "Buy the round and pass the Grand Tower with your dignity — and the crew's good humor.", cost: 2.0, action: "gt-treat"),
            (label: "Refuse — take the ducking", hint: "Let them shave and duck the greenhorn. It costs nothing but pride.", primary: true, action: "gt-duck"),
        ]),
        caveinrock: (options: [
            (label: "Take the stranger's pilot offer", hint: "He hails you from the bank, free of charge. A bargain — or a trap, depending on what you're carrying.", action: "cave-take"),
            (label: "Hire your own pilot — {cost}", hint: "The honest hand the Navigator names. Safe passage past the cave for a fee.", cost: 5.0, action: "cave-hire"),
            (label: "Run the shoals yourself", hint: "Free — but the channel below the cave is a serpentine of bars and rock. Hold your line.", primary: true, action: "cave-run"),
        ]),
        natchez: (options: [
            (label: "Sell cargo",                   hint: "Top prices on the river — sell it all.", gate: [HasCargo], action: "sell-cargo"),
            (label: "Sell the boat for lumber",     hint: "She can't go back upstream. The wood is worth real money.", gate: [HasBoat], action: "sell-boat"),
            (label: "Visit Under-the-Hill Saloon ▸", hint: "Faro and vingt-et-un by lamplight — the busiest tables on the river. Your purse rides as chips; leave the table whenever you like.", action: "saloon"),
            (label: "Sit in on the faro bank",       hint: "The banker's game, and the busiest table Under-the-Hill. Sit straight down — your purse rides as chips, and you leave with what you've still got.", action: "play-faro", group: Some("saloon")),
            (label: "Take a hand of vingt-et-un",    hint: "Twenty-one against the dealer, come up the river from New Orleans. Sit straight down — your purse rides as chips, and you leave with what you've still got.", action: "play-vingt-un", group: Some("saloon")),
            (label: "See the moneylender",          hint: "Settle your debt before the cash-out — or borrow against the boat.", action: "moneylender"),
            (label: "Buy a horse — {cost}",         hint: "Faster on the Trace, and the difference at the Duck River.", cost: 12.0, gate: [NoHorse], affordable_only: true, action: "buy-horse"),
            (label: "Set out on the Trace ▸",       hint: "The long walk home begins.", primary: true, action: "set-out"),
        ]),
        stand: (options: [
            (label: "Rest & resupply — {cost}", hint: "+30 provisions, recover some strength.", cost: 8.0, affordable_only: true, action: "rest"),
            (label: "Trade for a horse — {cost}", hint: "The Chickasaw offer a horse. It earns its keep at the Duck River.", cost: 14.0, gate: [NoHorse, AtStand("buzzard-roost")], affordable_only: true, action: "buy-horse"),
            (label: "🥾 Press on ▸", hint: "", primary: true, action: "leave"),
        ]),
    ),

    endings: [
        (cause: "boat-wrecked",  won: false, message: "Your flatboat broke apart and went down with everything aboard."),
        (cause: "drowned",       won: false, message: "You drowned trying to cross a flooded river on the Trace."),
        (cause: "bandit-murder", won: false, message: "Bandits cut you down on the Trace and took everything."),
        (cause: "disease",       won: false, message: "Fever and exhaustion took you on the long walk home."),
        (cause: "starved",       won: false, message: "Your provisions ran out and you starved in the wilderness."),
        (cause: "lost-in-woods", won: false, message: "Winter caught you still on the Trace, far from Nashville."),
        (cause: "victory",       won: true,  message: "You walked into Nashville with your earnings — a Kaintuck come home rich and alive."),
    ],

    // The branching outcomes of each minigame hazard. Tier is chosen by the host
    // from the minigame result; `drift` (1−accuracy, the sequence miss, or the
    // brigade leak ratio) scales the coefficients. `{cargo_lost}` / `{loss}`
    // interpolate the value taken by a preceding cargo/cash effect.
    outcomes: [
        // --- River heave: setting the handspikes and walking her off a bar ---
        (
            id: "sandbar",
            success: [
                Message(text: "Handspikes under her and all hands heaving — she lifts, slides, and floats free without losing a thing, though her bottom planks scrape the bar."),
                AdjustBoatDamage(4.0),
            ],
            partial: [
                LoseCargoFraction(base: 0.05, drift_coeff: 0.08, scale_by_draft: true),
                AdjustMorale(-8.0),
                Message(text: "She's stuck fast. You heave till the poles bend, dig, and roll her off at last — but she's gouged her hull on the bar and {cargo_lost} of cargo goes overboard in the working."),
                AdjustBoatDamage(12.0),
            ],
        ),
        // --- River heave: hauling the cordelle through the Grand Chain ---
        (
            id: "cordelle",
            success: [
                AdjustReputation(2.0),
                Message(text: "You land the crew, run the cordelle to the masthead, and walk her up through the boils of the Grand Chain by main strength. Six miles a day was good water here — and you made it clean."),
            ],
            partial: [
                AdjustMorale(-10.0),
                LoseCargoFraction(base: 0.04, drift_coeff: 0.10),
                Message(text: "The line fouls on the Cornice Rocks and she swings hard against the current, slamming the rocks — you fight her up, but the day is half lost and {cargo_lost} of cargo shakes loose over the side."),
                AdjustBoatDamage(10.0),
            ],
        ),
        // --- River set-piece: running the Falls of the Ohio ---
        (
            id: "falls-run",
            catastrophe_below: Some(0.15),
            catastrophe: [ Die("boat-wrecked") ],
            success: [
                AdjustReputation(5.0),
                Message(text: "The stream rolls on in a smooth unbroken sheet — she takes the chute, and in a few moments rides out into serene water below. A clean run of the two-mile rapid, and word of it travels downriver ahead of you."),
            ],
            partial: [
                LoseCargoFraction(base: 0.10, drift_coeff: 0.15),
                AdjustMorale(-15.0),
                Message(text: "You scrape the rocks of the Indian Chute coming through the falls — the hull grinds and splinters, and {cargo_lost} of cargo goes into the river."),
                AdjustBoatDamage(15.0),
            ],
        ),
        // --- River set-piece: running the shoals below Cave-in-Rock ---
        (
            id: "cave-run",
            catastrophe_below: Some(0.15),
            catastrophe: [ Die("boat-wrecked") ],
            success: [
                AdjustReputation(4.0),
                Message(text: "You thread the serpentine channel below the cave on your own judgment, past Tower Rock and Hurricane Island, and out clean. The pirates on the bank watch you go."),
            ],
            partial: [
                LoseCargoFraction(base: 0.10, drift_coeff: 0.15),
                AdjustMorale(-15.0),
                Message(text: "You strike a bar below the cave and hang there working free — she stoves a plank, and {cargo_lost} of cargo washes off into the channel."),
                AdjustBoatDamage(15.0),
            ],
        ),
        // --- Trace crowd-threading: pathfinding the firm line across a swamp ---
        (
            id: "swamp",
            success: [ Message(text: "You hold the firm line in your mind and pick your way across the swamp, out the far side dry.") ],
            fail: [
                AdjustHealth(-10.0),
                AdjustProvisions(-5.0),
                AdjustMiles(base: -5.0, drift_coeff: -10.0),
                Message(text: "You lose the firm line and flounder into the mire — losing ground, provisions, and strength."),
                DieIfDead("disease"),
            ],
        ),
        // --- Trace set-piece: fording the Duck River on foot ---
        (
            id: "duck-ford",
            catastrophe_below: Some(0.2),
            catastrophe_needs_unsteady: true,
            catastrophe: [ Die("drowned") ],
            success: [ Message(text: "You wade the Duck River, holding your footing against the current — wet, but whole.") ],
            partial: [
                AdjustHealth(-10.0),
                AdjustProvisions(-5.0),
                Message(text: "The current nearly takes you crossing the Duck River. You crawl out the far bank half-drowned."),
                DieIfDead("disease"),
            ],
        ),
        // --- River quick-draw: river pirates ---
        (
            id: "pirates",
            success: [
                AdjustReputation(3.0),
                Message(text: "Quick on the trigger — the pirates think better of it and sheer off."),
            ],
            partial: [
                LoseCargoFraction(base: 0.15, halve_if_grouped: true),
                AdjustReputation(-10.0),
                AdjustMorale(-10.0),
                Message(text: "The pirates board you and make off with {cargo_lost} of cargo before you beat them back, splintering her rail and gunwale in the scrap."),
                AdjustBoatDamage(8.0),
            ],
            fail: [
                LoseCargoFraction(base: 0.30, halve_if_grouped: true),
                AdjustReputation(-10.0),
                AdjustMorale(-10.0),
                Message(text: "The pirates board you and make off with {cargo_lost} of cargo before you beat them back, leaving her timbers hacked and stove in the fight."),
                AdjustBoatDamage(16.0),
            ],
        ),
        // --- Trace quick-draw: Sam Mason's gang ---
        // Mason robbed for money, not blood (RESEARCH_PIRATES §5) — so reaching
        // your hidden purse first buys your way out whole. The mechanic is the
        // scramble to find it (HotCold); a clean find palms them a decoy, a slow
        // find costs a share, a failed one the lot and a beating.
        (
            id: "mason",
            success: [
                AdjustReputation(5.0),
                Message(text: "Your hand finds the money belt in the hollow log first. You palm Mason's men a thin decoy purse; they paw through it, curse the light haul, and melt back into the brush. He wanted coin, not blood — and you kept yours."),
            ],
            partial: [
                TakeCashFraction(frac: 0.25, frac_grouped: 0.12, set_robbed: true),
                AdjustMorale(-8.0),
                Message(text: "You reach the purse a beat too late — they catch you digging and take {loss} before you can bluff them. You'd cached enough elsewhere to walk away with the rest."),
            ],
            fail: [
                TakeCashFraction(frac: 0.45, frac_grouped: 0.22, set_robbed: true),
                AdjustHealth(-12.0),
                DieIfDead("bandit-murder"),
                Message(text: "You never reach it. Mason's gang turns out your camp, takes {loss}, and leaves you bleeding on the Trace."),
            ],
        ),
        // --- Trace quick-draw: the Harpe brothers, north of the divide ---
        (
            id: "harpe",
            success: [
                AdjustReputation(6.0),
                Message(text: "You break away from the Harpes — a thing most men don't live to tell."),
            ],
            partial: [
                TakeCashFraction(frac: 0.6, frac_grouped: 0.3, set_robbed: true),
                AdjustHealth(-15.0),
                DieIfDead("bandit-murder"),
                Message(text: "The Harpe brothers fall on you, take {loss}, and leave you for dead."),
            ],
            fail: [
                TakeCashFraction(frac: 0.6, frac_grouped: 0.3, set_robbed: true),
                AdjustHealth(-20.0),
                DieIfDead("bandit-murder"),
                Message(text: "The Harpe brothers fall on you, take {loss}, and leave you for dead."),
            ],
        ),
        // --- Trace hunter: bagging game for the pot to spare the ration ---
        (
            id: "trace-hunt",
            success: [
                AdjustProvisions(14.0),
                Message(text: "One clean shot and the game drops. Fresh meat for the pot — the ration will stretch a good few days further."),
            ],
            partial: [
                AdjustProvisions(6.0),
                Message(text: "It bolts at the shot and you wing it, running it down in the brush. Lean meat, but meat — a little added to the stores."),
            ],
            fail: [
                Message(text: "The game breaks for the canebrake and is gone before you can chamber another round. Powder spent for nothing."),
            ],
        ),
        // --- Trace crowd-threading: keeping to the Trace among side trails ---
        (
            id: "side-trail",
            success: [
                AdjustReputation(1.0),
                Message(text: "You keep the Trace clear in your mind and make good time through the tangle of side trails."),
            ],
            fail: [
                AdjustMiles(base: -8.0, drift_coeff: -20.0),
                AdjustProvisions(-6.0),
                Message(text: "You lose the Trace on a side trail and waste a day doubling back."),
            ],
        ),
        // --- Trace timing-bar: dosing the swamp fever ---
        (
            id: "dose",
            success: [ Message(text: "You measure the dose right and sweat the fever out by morning.") ],
            fail: [
                AdjustHealth(-10.0),
                Message(text: "The fever burns through you — you can barely keep your feet."),
                DieIfDead("disease"),
            ],
        ),
        // --- River sequence: patching a snagged hull ---
        (
            id: "patch",
            success: [
                Message(text: "Wedge, oakum, plank — you patch the hole in good order before much water gets in, though the snag left its mark on her hull."),
                AdjustBoatDamage(6.0),
            ],
            partial: [
                LoseCargoFraction(base: 0.05, drift_coeff: 0.15),
                AdjustMorale(-8.0),
                Message(text: "You fumble the patch and she ships water — the breach widens and {cargo_lost} of cargo is ruined before you stop the leak."),
                AdjustBoatDamage(16.0),
            ],
        ),
        // --- River bucket-brigade: bailing a flooded boat ---
        (
            id: "bail",
            success: [
                LoseCargoFraction(base: 0.03),
                Message(text: "You bail her out ahead of the rising water — only {cargo_lost} of cargo lost, though the flood worked her seams loose."),
                AdjustBoatDamage(5.0),
            ],
            fail: [
                LoseCargoFraction(base: 0.08, drift_coeff: 0.25),
                AdjustMorale(-10.0),
                Message(text: "The flood gets ahead of you — her seams spring under the weight of water and {cargo_lost} of cargo is soaked and lost over the side."),
                AdjustBoatDamage(15.0),
            ],
        ),
        // --- River sequence: lying up to mend the hull yourself ---
        // The damage change itself is hand-coded (perfect mends her whole, a slip
        // mends in proportion, a botch leaves her worse); these supply only the
        // per-tier narration and morale.
        (
            id: "self-repair",
            success: [
                AdjustMorale(4.0),
                Message(text: "You work through the repair in good order — caulk, plank, and pitch — and stand back from a hull as sound as the day she was launched."),
            ],
            partial: [
                AdjustMorale(-3.0),
                Message(text: "You patch what you can reach before the light goes and the crew tires. She's the better for it, but not whole."),
            ],
            fail: [
                AdjustMorale(-8.0),
                Message(text: "Nothing goes right — you split a plank fitting it, foul the pitch, and leave her worse than you found her. Time and temper both wasted."),
            ],
        ),
    ],

    // The launch parameters for each minigame, fed straight into its component.
    // "gamble" is here too — its outcome is hand-coded, but its timing bar is data.
    minigames: [
        // Steadiness is now only "hold a line against a force": the Falls chute,
        // the Duck River ford. Grounding moved to Heave, the swamp to Crowd.
        (id: "falls-run",  params: Steady(prompt: "The Falls of the Ohio! Run the chute — hold your line through the rapids.", tolerance: 0.10, duration_ms: 7000, drift_speed: 1.6)),
        (id: "cave-run",   params: Steady(prompt: "Below Cave-in-Rock — thread the bars and rock of the serpentine channel.", tolerance: 0.11, duration_ms: 6800, drift_speed: 1.5)),
        (id: "duck-ford",  params: Steady(prompt: "Fording the Duck River on foot — hold against the current.",              tolerance: 0.11, duration_ms: 6500, drift_speed: 1.5)),
        // Heave — grounding is exertion, not precision: set the handspikes and
        // walk her off (push → lever → roller). A deep, heavy hold grounds harder.
        (id: "sandbar",    params: Heave(prompt: "She's hard aground on a bar — set the handspikes and heave her off. Pace it, don't snap the poles.", stages: 3, heave_rate: 0.022, hold_ticks: 8, slip_load: 0.92)),
        (id: "cordelle",   params: Heave(prompt: "The Grand Chain — land and haul her up through the rapids on the cordelle. Down on her, and heave!",  stages: 4, heave_rate: 0.020, hold_ticks: 9, slip_load: 0.90)),
        // HotCold — probe-and-deduce search: your own hidden purse in the dark
        // under ambush.
        (id: "mason",      params: HotCold(prompt: "Mason's men have you at gunpoint. Find your purse — hidden in the brush at camp — before they do.", cols: 5, rows: 5, max_probes: 7)),
        // Quick — now the river boarding only, with its own deck-fight words.
        (id: "pirates",    params: Quick(prompt: "River pirates grapple alongside and come over the gunwale — REPEL them!", words: ["REPEL", "FEND", "PIKE", "FIRE"])),
        // Hunter — track-and-shoot, finite ammo: the Harpe fight (surrender buys
        // nothing) and hunting for the pot to spare the ration.
        (id: "harpe",      params: Hunter(prompt: "The Harpe brothers are on you — no quarter, no bargain. Bring one down before they reach you!", hunted_icon: "H", cols: 7, rows: 5, ammo: 3, step_ms: 260, reload_ms: 900)),
        (id: "trace-hunt", params: Hunter(prompt: "Provisions run low. Game in the canebrake — bag it for the pot before it bolts.",               hunter_icon: "🤠", hunted_icon: "🦌", cols: 7, rows: 5, ammo: 5, step_ms: 330, reload_ms: 800)),
        // Crowd — route-memory: fix the way in mind, then thread it. The Trace
        // forking into side trails, and the firm line across a swamp's soupy mud.
        (id: "side-trail", params: Crowd(prompt: "The Trace forks into a dozen side trails. Fix the way north in your mind.", crowd_size: 11, member_icon: "🌲", player_icon: "🥾", exit_icon: "🚩", reveal_ms: 2800, navigate_ms: 11000)),
        (id: "swamp",      params: Crowd(prompt: "A 'hell hole' of soupy mud — fix the firm line in your mind, then pick your way across before the mire takes you.", crowd_size: 12, member_icon: "🟤", player_icon: "🥾", exit_icon: "🚩", reveal_ms: 3000, navigate_ms: 10000)),
        (id: "dose",       params: Timing(prompt: "Swamp fever. Measure out the dose — too much or too little does no good.", action: "POUR",    tolerance: 0.12, period_ms: 1500)),
        // Cards — the player buys a night at a Natchez table; the buy-in is the
        // escrowed stake (chips), and `target_mult` sets the mark to "win" the
        // night (× the buy-in). Faro was the era's dominant bank game; vingt-et-un
        // the twenty-one that came up from New Orleans (RESEARCH_GAMBLING).
        (id: "faro",       params: Faro(prompt: "Under-the-Hill — the faro bank is open. Lay your chips on the layout and call the turn.", target_mult: 2.0, min_bet: 2)),
        (id: "vingt-un",   params: VingtUn(prompt: "Under-the-Hill — a chair opens at the vingt-et-un table. Twenty-one beats the dealer.", target_mult: 2.0, min_bet: 2, max_rounds: 10)),
        // "gamble" stays for the autonomous economy (the bots gamble on a whim);
        // its outcome is hand-coded, its timing bar data.
        (id: "gamble",     params: Timing(prompt: "Under-the-Hill — lay your stake and call it as the wheel comes round.",    action: "CALL IT", tolerance: 0.10, period_ms: 1300)),
        (id: "cave-tell",  params: Timing(prompt: "The stranger offers to pilot you past the cave. Watch his eyes — call it the instant you read the tell.", action: "READ HIM", tolerance: 0.11, period_ms: 1400)),
        (id: "patch",      params: Sequence(prompt: "A snag punches a hole in the hull — patch it in order before she fills.", symbols: ["🪵", "🧵", "🔨", "🪣"], length: 4)),
        (id: "bail",       params: Brigade(prompt: "High water floods the boat — bail her out faster than she fills!", threat_icon: "💧", cols: 5, rows: 5, initial_active: 3, spread_ms: 750, duration_ms: 8000)),
        // Self-repair — the sequence length is overridden by the engine to scale
        // with the hull damage (the worse she's hurt, the longer the job); the
        // `length` here is only the floor the host falls back to.
        (id: "self-repair", params: Sequence(prompt: "Lay up and mend her — set each repair in the right order, or you'll do more harm than good.", symbols: ["🔨", "🪵", "🧵", "🪣", "⚓"], length: 4)),
    ],

    // Ambient crew banter, played on quiet (clean) legs instead of the flat
    // "quiet stretch" line. Pools are keyed by region (phase + milepost band);
    // river position is the leg's origin landing, Trace position is miles walked.
    // Each beat plays at most once. Authoring: lead with the questioner/expert
    // device — a green hand asks, an old hand explains — keep beats to 2-4 short
    // lines, and keep the history period-true (early-1800s flatboat trade and the
    // Natchez Trace walk home). Voices are free text that prefixes the line.
    banter: [
        // ----- Upper Ohio: Pittsburgh and Wheeling, settling into the run -----
        (
            phase: River, from_mile: 0.0, to_mile: 470.0,
            beats: [
                (
                    key: "upper-ohio-current",
                    lines: [
                        (voice: "The farmhand squints downriver:", text: "We just ride it the whole way down?"),
                        (voice: "The old riverman spits over the side:", text: "The Ohio does the work clear to its mouth. Easy water — bars and snags, mostly. Save your worry for the Mississippi."),
                    ],
                ),
                // The thesis of the whole trade, taught early so it can guide the
                // player's buying: every town is its own market. The false rumor
                // it corrects is the natural assumption that prices are fixed; the
                // wharf-factor reality at each dock then proves it leg by leg.
                (
                    key: "rumor-river-prices",
                    lines: [
                        (voice: "The farmhand frowns over his tally:", text: "Prices is the same the whole river down, ain't they? Same coin at every wharf, top to bottom."),
                        (voice: "The old riverman laughs:", text: "Then you'll die poor, boy. Every town's its own market — cheap where they make a thing, dear where they can't. Read the wharf when you tie up, not the talk on the water."),
                    ],
                ),
                (
                    key: "upper-ohio-trade",
                    lines: [
                        (voice: "The boatwright thumps the gunwale:", text: "Whiskey, flour, salt pork — worth three times at Natchez what it fetched in Pittsburgh. Float it down, sell it high, break the boat up for lumber. That's the whole game."),
                    ],
                ),
                (
                    key: "the-fiddler",
                    lines: [
                        (voice: "The farmhand nods at the old man sawing a fiddle at the bow:", text: "Does he pull an oar like the rest of us, or just play?"),
                        (voice: "The old riverman grins:", text: "Pappy? First man in the water when she grounds on a bar, and he fiddles the whole night watch besides. Brought nothing aboard but his violin and Katy and his plunder. Worth two hands for the singing alone."),
                    ],
                ),
                (
                    key: "rowing-song",
                    lines: [
                        (voice: "The crew settles into a stroke, and a song goes up to keep the time:", text: "\"Some rows up, but we rows down — all the way to Shawnee town — pull away, pull away!\""),
                    ],
                ),
                (
                    key: "marietta-yard",
                    lines: [
                        (voice: "The boatwright jerks a thumb at a riverside town of saw-pits and ways:", text: "Marietta yonder builds seagoing ships — rigged brigs at fifty dollar a ton — and floats 'em clear down to the ocean. Our flatboat won't ever see salt water. She's a pile of lumber the day we tie up at Natchez."),
                    ],
                ),
                // Rumor — the dockside truth (the wharf-factor line on arrival)
                // either confirms or trims it.
                (
                    key: "rumor-porkopolis",
                    lines: [
                        (voice: "The farmhand leans in, lowering his voice:", text: "Fella at the last wooding stop swears Cincinnati pork's so cheap they near give it away. Load the hold and we're rich men at Natchez."),
                        (voice: "The old riverman snorts:", text: "Porkopolis earns the name, I'll grant him. But 'near give it away' is wharf talk. Hear it cheap, see it cheap on the dock, then buy — a rumor never filled a hold yet."),
                    ],
                ),
                (
                    key: "rumor-kentucky-leaf",
                    lines: [
                        (voice: "The boatwright nods toward the Kentucky shore:", text: "Maysville's the place for leaf — burley off the bluffs, cured sweet, cheaper there than anywhere above it. Tobacco and a drove of hogs on the hoof, that's Kentucky's offering."),
                    ],
                ),
            ],
        ),
        // ----- Lower Ohio: the Falls, and the wreckers' cave -----
        (
            phase: River, from_mile: 470.0, to_mile: 980.0,
            beats: [
                (
                    key: "the-falls",
                    lines: [
                        (voice: "The boatwright nods downstream:", text: "Below Louisville the river drops over the Falls of the Ohio — two mile of bare rock. Hire a pilot or wait on high water. The ones who run it blind feed the catfish."),
                    ],
                ),
                (
                    key: "cave-in-rock",
                    lines: [
                        (voice: "The farmhand points at a black gash in the bluffs:", text: "What's that cave yonder?"),
                        (voice: "The old riverman doesn't look up:", text: "Cave-in-Rock. River pirates laired there — hung out a sign for liquor to lure boats ashore, then took the cargo and sank the rest. Keep to the channel. Don't put in, no matter who waves you down."),
                    ],
                ),
                (
                    key: "the-wreckers",
                    lines: [
                        (voice: "A man on the bank waves a pole and hollers an offer to pilot you past the shoals:", text: "\"Channel's wicked through here, captain! Take me on — dollar or two and I'll thread you clean!\""),
                        (voice: "The old riverman doesn't slow:", text: "Wreckers. Their whole trade — talk their way to your steering oar, then ground you on a bar where their friends are waiting. Refuse 'em and they'll bawl false directions to wreck you anyhow. Best pilot's the one who don't have to chase your boat down."),
                    ],
                ),
                (
                    key: "colonel-plug",
                    lines: [
                        (voice: "The old riverman nods at a half-sunk hulk rotting on a bar:", text: "Boat-wrecker's work, that. The famousest of 'em was a New Hampshire man — Colonel Plug, his wife they called Pluggy. He'd slip aboard a tied-up boat and dig the caulkin' out the bottom so she'd sink slow, then 'rescue' the cargo for hisself."),
                        (voice: "He spits over the side:", text: "Got his comeuppance, though. Down in a boat's belly diggin' out the oakum when a squall snapped her line and run her into the river — sank her with the Colonel still aboard. The river keeps a fair set of books."),
                    ],
                ),
                (
                    key: "the-hail",
                    lines: [
                        (voice: "A boat sweeps past and a man cups his hands across the water:", text: "\"Where you from? What's your lading? Who's your captain? Where you bound?\""),
                        (voice: "The old riverman bawls back without missing a beat:", text: "\"Redstone! Millstones! Whetstone! — Limestone!\" Same four hollers, every boat on the river. Quick with the answer or you're the joke of the reach."),
                    ],
                ),
                (
                    key: "blackguarding",
                    lines: [
                        (voice: "Two boats drift in earshot and the crews start trading insults across the gap:", text: "Whooping, hollering, every man straining to outdo the last."),
                        (voice: "The old riverman, cheerful:", text: "Blackguardin', we call it. Whoever leaves the other fellow with nothing left to say is the hero of the day. The one who runs dry is his crew's joke for a week. It's all wind — mostly."),
                    ],
                ),
                (
                    key: "the-horn",
                    lines: [
                        (voice: "The farmhand startles at a low, mournful note rolling over the water:", text: "What in creation was that?"),
                        (voice: "The old riverman:", text: "Boat horn. Sound it in fog so the next fellow don't run you down — and they say it scares off the devil and brings fair luck besides. Can't hurt. Wind it again, boy."),
                    ],
                ),
                (
                    key: "shore-dance",
                    lines: [
                        (voice: "Tied up by a settler's cabin, a fiddle strikes up and the men stamp out the time:", text: "\"Dance, boatman, dance — dance all night till broad daylight — and go home with the gals in the morning!\""),
                    ],
                ),
                (
                    key: "rumor-falls-bourbon",
                    lines: [
                        (voice: "The farmhand wipes his brow:", text: "They say the whiskey's a different thing below the Falls — corn liquor, barreled brown."),
                        (voice: "The old riverman nods:", text: "Bourbon, out of Kentucky. Comes cheap at Louisville where they barrel it above the rapids. Lay in a few kegs and they'll bless you for 'em down south."),
                    ],
                ),
                (
                    key: "rumor-hungry-landings",
                    lines: [
                        (voice: "The old riverman eyes the thinning settlements:", text: "Mark the lower landings — Shawneetown and the like. Salt towns, swamp towns, growin' little but trouble. Flour and pork go dear there; they buy whatever floats past. Sell what you can spare before the country empties out."),
                    ],
                ),
            ],
        ),
        // ----- The Mississippi: Cairo down to Natchez, the dangerous water -----
        (
            phase: River, from_mile: 980.0, to_mile: 1830.0,
            beats: [
                // Surly-crew variant first: only fires when morale has worn thin,
                // else it's skipped and the next beat plays.
                (
                    key: "mississippi-grumble",
                    gates: [MoraleBelow(50.0)],
                    lines: [
                        (voice: "A hand mutters at his oar:", text: "Triple pay at Natchez, he keeps saying. If we live to count it."),
                    ],
                ),
                (
                    key: "big-muddy",
                    lines: [
                        (voice: "The farmhand:", text: "Lord — the river's near a mile across now."),
                        (voice: "The old riverman:", text: "That's the Mississippi. Swallowed the Ohio back at Cairo. Runs faster, hides more — and the men who work these banks ain't all honest."),
                    ],
                ),
                (
                    key: "natchez-under-the-hill",
                    lines: [
                        (voice: "The old riverman lowers his voice:", text: "Natchez sits proud on the bluff, but the landing under it — Natchez-under-the-Hill — is all grog, cards, and cut throats. Sell your cargo up top. Men have lost the whole trip down below."),
                    ],
                ),
                (
                    key: "river-names",
                    lines: [
                        (voice: "The old riverman reads the water like a page, naming every snarl as it slides past:", text: "Yonder's the Devil's Elbow — worst bend on the river. That cluster of islands is Paddy's Hen and Chickens. That long bar's General Hull's Left Leg. Every reach has its name, and knowing 'em is half of staying afloat."),
                    ],
                ),
                (
                    key: "stack-island",
                    lines: [
                        (voice: "The farmhand eyes a low willow island sliding past:", text: "Looks a lonesome place to tie up."),
                        (voice: "The old riverman keeps to the channel:", text: "That's Stack Island water — Crow's Nest, the pirates called it. Counterfeiters and cutthroats laired there for years, paid honest crews in bad coin and robbed the rest. Then the big earthquake of 'eleven come and swallowed island, robbers, and all. Some debts the river settles itself."),
                    ],
                ),
                (
                    key: "mason-river",
                    lines: [
                        (voice: "The farmhand lowers his voice:", text: "That Cave-in-Rock — whose lair was it, truly?"),
                        (voice: "The old riverman:", text: "Sam Mason's, more years than not. Fine-looking man, soft-spoke, a captain in the war once — and the worst river pirate that ever cut a throat for a cargo. When the cave got too hot he didn't quit the trade. He carried it overland, onto the Natchez Trace. Same road you'll walk home, boy."),
                    ],
                ),
                (
                    key: "night-camp",
                    lines: [
                        (voice: "You tie up at dusk and the boy slaps at the air:", text: "These skeeters mean to carry me clean off."),
                        (voice: "The old riverman heaps green wood on a smudge fire:", text: "Smudge'll hold 'em back. Eat your ration, then it's cards or a coon hunt or a yarn till the fire dies down. Sleep on the bank — or atop the cargo if it comes on to rain. We're off again at first light."),
                    ],
                ),
                (
                    key: "boatman-song",
                    gates: [MoraleAbove(60.0)],
                    lines: [
                        (voice: "Late, with the jug going round the deck, the old song starts up of its own accord:", text: "\"The boatman is a lucky man, no one can do as the boatman can... Hi-O, away we go, floating down the river on the O-hi-o!\""),
                    ],
                ),
                (
                    key: "french-song",
                    lines: [
                        (voice: "A barge of Creole boatmen sweeps past, the steersman calling a line and the crew answering it back:", text: "\"L'on, ton, laridon, danée... L'on, ton, laridon, dai!\""),
                        (voice: "The old riverman listens a moment:", text: "French rivermen. Better singers than us by a country mile — sing the whole day to keep their minds off the work and the wild country. Half don't know what the words mean. Don't seem to matter."),
                    ],
                ),
            ],
        ),
        // ----- The Trace, before the divide: why you walk, and whose land it is -----
        (
            phase: Trace, from_mile: 0.0, to_mile: 423.9,
            beats: [
                (
                    key: "why-walk",
                    lines: [
                        (voice: "The boy shifts his pack:", text: "Why walk? We had a good boat."),
                        (voice: "The old trace-walker:", text: "Can't pole a flatboat back up two thousand mile of current, son. Everybody walks the Trace home — five hundred mile of woods, Natchez to Nashville."),
                    ],
                ),
                (
                    key: "the-stands",
                    lines: [
                        (voice: "The old trace-walker:", text: "These inns — the stands — most are kept by Chickasaw and Choctaw on their own land. A meal, a roof, and you're safe while you're under it. Mind your manners. We're guests the whole way north."),
                    ],
                ),
                (
                    key: "grindstone-ford",
                    lines: [
                        (voice: "Crossing a creek at a stone ford, the old trace-walker stops to fill his canteen:", text: "Grindstone Ford. Mark it well — last roof and last hot meal you'll see this side of Nashville, and that's near five hundred mile of woods off. From here north it's your own two feet, your own rifle, and whatever you sewed into your belt."),
                    ],
                ),
                (
                    key: "mason-wanted",
                    gates: [Marked(true)],
                    lines: [
                        (voice: "A broadside is nailed to a post where the trail forks — you stop to read it:", text: "ONE THOUSAND DOLLARS REWARD — SAMUEL MASON — dead or alive."),
                        (voice: "The old trace-walker spits:", text: "Your boat's the one his men jumped at the cave. They don't forget a face, and a thousand dollars buys a lot of forgetting from anyone who has. Walk in the middle of the party from here, and keep that money out of sight."),
                    ],
                ),
            ],
        ),
        // ----- Past the divide: Harpe country -----
        (
            phase: Trace, from_mile: 423.9, to_mile: 1000.0,
            beats: [
                (
                    key: "harpe-country",
                    lines: [
                        (voice: "The boy:", text: "You've gone quiet since that last ridge."),
                        (voice: "The old trace-walker keeps his voice low:", text: "Past the divide now. The Harpes worked this stretch — meanest cutthroats the Trace ever bred. They're dead and gone. Their kind never quite is. Walk close, and don't straggle once it's dark."),
                    ],
                ),
                (
                    key: "mason-end",
                    gates: [Marked(true)],
                    lines: [
                        (voice: "Riders pass southbound and call out news from the settlements:", text: "Mason's dead! His own men took his head for the reward — and one of 'em turned out to be Little Harpe himself, hanged for it at Greenville."),
                        (voice: "The old trace-walker grunts, almost a laugh:", text: "So the cave-pirate you crossed is finished, betrayed by his own and undone by a Harpe. There's a kind of justice on this road, even if it keeps strange company. Don't let it make you careless — his trade outlived him."),
                    ],
                ),
                (
                    key: "colberts-ferry",
                    lines: [
                        (voice: "The trail drops toward a wide, deep river with a rope ferry working the far bank:", text: "Too deep and too swift to ford — you pay to cross here. Colbert's ferry, a dollar a head, and his Chickasaw hands are a contrary lot. Come up after they've bedded down and you'll wait on daylight whether you like it or no. Man clears two thousand a year off this crossing alone."),
                    ],
                ),
                (
                    key: "hell-holes",
                    lines: [
                        (voice: "The boy goes in to his shins in black muck and swears:", text: "There's no bottom to this!"),
                        (voice: "The old trace-walker hauls him out by the pack strap:", text: "Hell holes, they call these — soupy mud, dense cane, and skeeters thick enough to bridle. Worst seventy-five mile on the whole Trace, between the rivers here. Keep moving. Stand still too long and the country eats you."),
                    ],
                ),
            ],
        ),
    ],

    // Boat damage & repair tuning (the River phase). Damage accrues from the
    // hazard outcomes' AdjustBoatDamage effects and is mended in port (a
    // boatwright at Louisville/Memphis) or by self-repair (a sequence that costs
    // days and rolls the moored-hazard table below).
    repair: (
        boatyards: [5, 9],            // Louisville, Memphis
        port_cost_per_point: 0.9,     // ~$45 to mend a half-wrecked hull
        salvage_damage_coeff: 0.6,    // a wreck fetches 40% of sound lumber value
        seepage_threshold: 40.0,      // she only weeps once badly hurt
        seepage_coeff: 0.04,          // up to ~4% cargo/leg at full damage
        outcome_drift_coeff: 0.5,     // a battered hull bleeds more on every mishap
        self_repair_days: 2,          // two days lost lying up
        self_seq_max_len: 8,          // a near-wreck is an 8-step job (base = the
                                      // self-repair minigame's own length, below)
        bomb_penalty: 12.0,           // a botched repair leaves her worse
        moored_hazards: (
            // While tied up: mostly a quiet berth, sometimes the work goes wrong
            // (more damage), a surly crew, or a sneak-thief passing counterfeit.
            thresholds: [55.0, 75.0, 90.0],
            grouped_thins: [],
            arms: [
                Clean(message: Some("You find a quiet berth out of the current and set to work.")),
                Special("moor-mishap"),
                Special("crew-grumble"),
                Special("counterfeit"),
            ],
        ),
    ),

    // Trader "gossip": flavor for the shared (multiplayer) world. When the player
    // is connected to a server, the crew talks about the OTHER traders — by name
    // and temperament — on dock arrivals and quiet legs. Inert in single-player.
    // Phrasing placeholders: {trader} {persona} {good} {town} {cause}.
    gossip: (
        names: [
            "Lemuel Boggs", "Silas Crews", "Big Reuben Pike", "Ezekiel Tharp",
            "Jeb Tolliver", "Casper Wendt", "Obed Marsh", "Asa Quill",
            "Hiram Doss", "Noah Skaggs", "Gideon Burl", "Methuselah Crow",
        ],
        voices: [
            "A passing boatman hails:",
            "Your steersman jerks a thumb downriver:",
            "The wharf talk runs:",
            "A flatboat drifts past, its crew calling across the water:",
            "Word comes up the river:",
        ],
        personas: [
            (key: "greedy",   epithet: "a sharp dealer who buys cheap and sells dear"),
            (key: "cautious", epithet: "a cautious hand who runs in company"),
            (key: "reckless", epithet: "a reckless sort who'll gamble on anything"),
        ],
        lines: [
            // Trades are keyed by side × price tier (vs the good's resting
            // baseline), so the line carries the actionable signal a player
            // heading to {town} wants: bid up, ordinary, or glutted.
            (kind: "trade_buy_premium", templates: [
                "{trader} paid through the nose for {good} at {town} — it's bid up there now.",
                "They say {trader}, {persona}, bought {good} dear at {town}; the wharf's bid up.",
            ]),
            (kind: "trade_buy_fair", templates: [
                "{trader}, {persona}, bought up the {good} at {town}.",
                "They say {trader} took on a hold of {good} at {town}.",
            ]),
            (kind: "trade_buy_cheap", templates: [
                "{trader} loaded {good} cheap at {town} — going for a song there.",
                "Word is {trader} cleaned the cheap {good} off the wharf at {town}.",
            ]),
            (kind: "trade_sell_dear", templates: [
                "{trader} sold {good} dear at {town} — they're short of it there.",
                "{trader}, {persona}, got a fine price for {good} at {town}; it's scarce there.",
            ]),
            (kind: "trade_sell_fair", templates: [
                "{trader} sold off a hold of {good} at {town}.",
                "{trader}, {persona}, moved a load of {good} through {town}.",
            ]),
            (kind: "trade_sell_glut", templates: [
                "{trader} dumped {good} into {town} — it's glutted, going cheap there now.",
                "They say {trader} flooded {town} with {good}; it's cheap there now.",
            ]),
            (kind: "arrived", templates: [
                "{trader} put in at {town}, they say.",
                "Saw {trader}'s boat tied up at {town}.",
            ]),
            (kind: "reached_natchez", templates: [
                "{trader} brought a boat down to Natchez — {persona}.",
                "Word is {trader} reached the Under-the-Hill landing.",
            ]),
            (kind: "set_out_on_trace", templates: [
                "{trader} sold the boat for lumber and struck out up the Trace.",
                "{trader}'s walking the Trace home now.",
            ]),
            (kind: "robbed", templates: [
                "Pirates took {trader} — {persona}, and it still cost them.",
                "Heard {trader} got robbed downriver.",
            ]),
            (kind: "won", templates: [
                "{trader} made Nashville rich — {persona}.",
                "{trader} got home with the goods; a tidy reckoning.",
            ]),
            (kind: "lost", templates: [
                "Word is {trader} {cause} — never made it home.",
                "They say {trader} {cause}; a hard end.",
            ]),
        ],
    ),
    // Dockside rumors: advance word about how the NEXT landing will price a
    // good. Each tip is attributed to a `source` with a reliability; over a run
    // the player learns who to trust. Lines are keyed by predicted price band
    // ("dear"/"cheap"/"ordinary"), `confirms` by the payoff ("held"/"wind").
    // Placeholders: {good} {town}. (Authored corpus; regenerate via
    // `just gen-rumors` — see scripts/gen-rumors.mjs.)
    rumors: (
        sources: [
            (key: "harbormaster", voice: "The harbormaster looks up from his ledger:", reliability: 0.85),
            (key: "factor",       voice: "A commission factor leans in, confidential:", reliability: 0.75),
            (key: "pilot",        voice: "A packet pilot off the up-boat allows:",       reliability: 0.70),
            (key: "keelboatmen",  voice: "A keelboat crew poling upstream call across the water:", reliability: 0.55),
            (key: "drunk",        voice: "A flatboatman deep in his cups swears blind:", reliability: 0.35),
            (key: "sharp",        voice: "A card sharp at the tavern grins and lets slip:", reliability: 0.30),
        ],
        lines: [
            (kind: "dear", templates: [
                "{good} is fetching a king's ransom down at {town} — load all you can carry.",
                "They're fair crying for {good} at {town}; it'll sell dear there.",
                "{town}'s short of {good} this season — a full hold would bring a premium.",
                "Carry {good} down to {town} and you'll near name your price; they've none of their own.",
                "The wharf at {town} is hungry for {good} — it's worth the hold.",
                "If you've {good} to spare, hold it for {town}; they're paying through the nose.",
            ]),
            (kind: "cheap", templates: [
                "Don't waste a hold on {good} for {town} — the levee's drowning in it, going for a song.",
                "{good}'s a glut at {town}; you'll all but give it away there.",
                "They've {good} to burn at {town} — no money in carrying it down.",
                "Word is {town}'s flooded with {good}; you'd do better selling it elsewhere.",
                "{good} fetches next to nothing at {town} just now — load something else.",
                "Skip {good} for {town}, friend — it's cheap as dirt on that wharf.",
            ]),
            (kind: "ordinary", templates: [
                "{good}'s moving at a fair price down at {town}, no better nor worse.",
                "Nothing special on {good} at {town} — middling money.",
                "They say {good} sits at about its usual rate at {town}.",
                "{good}'ll fetch the going rate at {town}; no fortune in it.",
                "Ordinary trade in {good} at {town}, by all accounts.",
            ]),
        ],
        confirms: [
            (kind: "held", templates: [
                "The word held — {good} traded down at {town} just as you were told.",
                "That tip was good as gold; {good} went at {town} exactly as promised.",
                "Whoever steered you on {good} at {town} knew their business.",
                "The rumor proved out — {good} at {town}, true to the letter.",
                "Good word, that: {good} at {town} ran true.",
            ]),
            (kind: "wind", templates: [
                "So much for that tip — {good} at {town} was nothing like the word.",
                "That was wind: {good} at {town} traded clean against the rumor.",
                "Whoever told you on {good} at {town} was lying or too deep in his cups.",
                "The word was wrong — {good} at {town} went the other way entirely.",
                "A bad steer, that one: {good} at {town} made a liar of the rumor.",
            ]),
        ],
    ),
)
