// Kaintuck — the data-driven scenario. A faithful port of the hand-written
// content/flow that used to live in the engine source. Stage 1 covers the
// static tables (goods, boats, towns, stands, pace economy, scoring, endings);
// hazard structure, branching outcomes, and set-pieces are layered on later.
//
// Numbers here mirror the old `const`s exactly and are guarded by the
// `scenario_matches_legacy_consts` test — do not retune without intent.
Scenario(
    goods: [
        (name: "Corn",      units: 1),
        (name: "Whiskey",   units: 1),
        (name: "Flour",     units: 1),
        (name: "Tobacco",   units: 1),
        (name: "Pork",      units: 1),
        (name: "Hides",     units: 1),
        (name: "Livestock", units: 2),
    ],

    boats: [
        (label: "Skiff",     cost: 40.0,  capacity: 30,  draft: 0.7, lumber_value: 25.0, hint: "cheap, light, shallow — small load"),
        (label: "Flatboat",  cost: 75.0,  capacity: 60,  draft: 1.0, lumber_value: 55.0, hint: "the workhorse of the river"),
        (label: "Broadhorn", cost: 130.0, capacity: 100, draft: 1.4, lumber_value: 95.0, hint: "hauls a fortune — and draws deep water"),
    ],

    start: (
        cash: 50.0,
        credit_cap: 200.0,
        crew_wage: 3.0,
        provisions: 50.0,
    ),

    river: (
        river_miles: 1830.0,
        towns: [
            (name: "Pittsburgh",  slug: "pittsburgh",  milepost: 0.0,    base_ranks: [2, 8,  4, 6,  5,  7,  12], moneylender: false),
            (name: "Wheeling",    slug: "wheeling",    milepost: 90.0,   base_ranks: [2, 10, 4, 7,  6,  7,  11], moneylender: false),
            (name: "Marietta",    slug: "marietta",    milepost: 170.0,  base_ranks: [2, 11, 5, 8,  6,  7,  13], moneylender: false),
            (name: "Maysville",   slug: "maysville",   milepost: 410.0,  base_ranks: [3, 12, 5, 8,  7,  8,  15], moneylender: false),
            (name: "Cincinnati",  slug: "cincinnati",  milepost: 470.0,  base_ranks: [3, 13, 6, 9,  7,  8,  17], moneylender: true),
            (name: "Louisville",  slug: "louisville",  milepost: 600.0,  base_ranks: [3, 14, 6, 10, 8,  9,  18], moneylender: false),
            (name: "Shawneetown", slug: "shawneetown", milepost: 850.0,  base_ranks: [3, 14, 6, 11, 8,  9,  18], moneylender: false),
            (name: "Cairo",       slug: "cairo",       milepost: 980.0,  base_ranks: [3, 15, 6, 11, 8,  10, 19], moneylender: false),
            (name: "Grand Tower", slug: "grand-tower", milepost: 1010.0, base_ranks: [3, 16, 6, 11, 9,  10, 19], moneylender: false),
            (name: "Memphis",     slug: "memphis",     milepost: 1430.0, base_ranks: [3, 16, 6, 11, 9,  11, 19], moneylender: true),
            (name: "Natchez",     slug: "natchez",     milepost: 1830.0, base_ranks: [4, 21, 8, 14, 11, 15, 18], moneylender: false,
                // The lower river (Cave-in-Rock down toward Natchez) was the
                // piracy gauntlet. The pirate arm is arms[3], whose band is
                // (thresholds[1], thresholds[2]]: this override widens it from
                // (20,30] = 10% to (14,44] = 30%, trimming the other minor arms.
                // The top threshold stays 60, so the clean residual above it is
                // unchanged at 40% — this leg is no more eventful overall, its
                // events are just three times as likely to be river pirates.
                hazards: Some((
                    thresholds: [8.0, 14.0, 44.0, 50.0, 55.0, 60.0],
                    grouped_thins: [],
                    arms: [
                        Clean(message: Some("The current carries you on, but every snag on the bank looks like a hidden skiff.")),
                        Minigame(outcome: "sandbar", message: Some("The river bends hard at the Devil's Elbow and a bar reaches out from the point.")),
                        Minigame(outcome: "patch"),
                        Minigame(outcome: "pirates", message: Some("River pirates pull alongside!"), cover: Some("pirates")),
                        Special("spoilage"),
                        Special("crew-grumble"),
                        Minigame(outcome: "bail"),
                    ],
                ))),
        ],
        // arms[0] is a clean leg; arms[1..] line up with the thresholds above.
        hazards: (
            thresholds: [10.0, 20.0, 30.0, 42.0, 52.0, 60.0],
            grouped_thins: [],
            arms: [
                Clean(message: Some("The current carries you on. A quiet stretch of river.")),
                Minigame(outcome: "sandbar"),
                Minigame(outcome: "patch"),
                Minigame(outcome: "pirates", message: Some("River pirates pull alongside!"), cover: Some("pirates")),
                Special("spoilage"),
                Special("crew-grumble"),
                Minigame(outcome: "bail"),
            ],
        ),
    ),

    trace: (
        total_miles: 450.0,
        max_days: 40,
        divide_at: 423.9,
        duck_river_at: 440.0,
        horse_multiplier: 1.6,
        paces: [
            (label: "Steady", miles_per_day: 14.0, provisions_cost: 4.0, health_cost: 1.0),
            (label: "Hard",   miles_per_day: 20.0, provisions_cost: 6.0, health_cost: 4.0),
        ],
        stands: [
            (label: "Mount Locust",            key: "mount-locust",  milepost: 15.5,  kind: Rest,          flavor: "The first inn north of Natchez. A meal of corn mush and a place on the porch."),
            (label: "The Choctaw Territory",   key: "choctaw",       milepost: 120.0, kind: Rest,          flavor: "Deep in Choctaw country, the forest closes in. Rest while you can."),
            (label: "Buzzard Roost Spring",    key: "buzzard-roost", milepost: 320.3, kind: Rest,          flavor: "A prosperous Chickasaw stand. They keep travelers fed, safe — and coming back."),
            (label: "Tennessee Valley Divide", key: "tn-divide",     milepost: 423.9, kind: Rest,          flavor: "The Tennessee Valley Divide — the old border. Harpe country lies north."),
            (label: "Duck River Crossing",     key: "duck-river",    milepost: 440.0, kind: RiverCrossing, flavor: "The Duck River crossing."),
        ],
        // arms[0] is a clean day; travelling in company thins the bandit
        // ambushes (arms 1 and 2). Arm 2 is the Harpes past the divide, the
        // swamp fever before it.
        hazards: (
            thresholds: [8.0, 16.0, 26.0, 34.0, 50.0],
            grouped_thins: [1, 2],
            arms: [
                Clean(),
                Minigame(outcome: "mason"),
                Branch(
                    past_divide: Minigame(outcome: "harpe"),
                    before: Minigame(outcome: "dose"),
                ),
                Minigame(outcome: "dose"),
                Minigame(outcome: "side-trail"),
                Minigame(outcome: "swamp"),
            ],
        ),
    ),

    scoring: (
        base_win: 1500.0,
        crew_bonus: 75.0,
        rep_mult: 4.0,
        rep_floor: -100.0,
        robbed_penalty: -300.0,
        speed_par_days: 35,
        speed_per_day: 20.0,
        loss_miles_div: 4.0,
        loss_leftover_div: 4.0,
        ranks: [
            (min: 5000, name: "River King"),
            (min: 3500, name: "Master Kaintuck"),
            (min: 2000, name: "Trader"),
            (min: 900,  name: "Boatman"),
            (min: 1,    name: "Greenhorn"),
        ],
        floor_rank: "Drowned Rat",
    ),

    setpieces: (
        ferry_toll: 6.0,
        rest_provisions: 30.0,
        rest_health: 10.0,
        falls_pilot_msg: "A falls pilot takes the steering oar and threads you down the two-mile chute, clean.",
        ferry_cross_msg: "The ferryman poles you across the Duck River, dry and whole.",
        duck_horse_msg: "You reach the Duck River. Astride your horse you pick a line through the current and cross without much trouble.",
    ),

    // The buttons each set-piece screen shows. Gates hide an option until its
    // condition holds; `affordable_only` disables (rather than hides) when the
    // purse is short. `{cost}` in a label is filled with the formatted cost.
    menus: (
        falls: (options: [
            (label: "Hire a falls pilot — {cost}", hint: "A local takes the oar and threads you down. A sure thing.", cost: 8.0, action: "falls-pilot"),
            (label: "Run the falls yourself",       hint: "Free — but the current is violent. Hold your line.", primary: true, action: "falls-run"),
            (label: "Wait for high water",          hint: "Safe passage, but it costs days and frays the crew.", action: "falls-wait"),
        ]),
        grandtower: (options: [
            (label: "Stand a treat — {cost}", hint: "Buy the round and pass the Grand Tower with your dignity — and the crew's good humor.", cost: 2.0, action: "gt-treat"),
            (label: "Refuse — take the ducking", hint: "Let them shave and duck the greenhorn. It costs nothing but pride.", primary: true, action: "gt-duck"),
        ]),
        natchez: (options: [
            (label: "Sell cargo",                   hint: "Top prices on the river — sell it all.", gate: [HasCargo], action: "sell-cargo"),
            (label: "Sell the boat for lumber",     hint: "She can't go back upstream. The wood is worth real money.", gate: [HasBoat], action: "sell-boat"),
            (label: "Spend a night Under-the-Hill", hint: "Gambling, drinking, and thieves. Every dollar lost hurts the walk.", action: "gamble"),
            (label: "Buy a horse — {cost}",         hint: "Faster on the Trace, and the difference at the Duck River.", cost: 12.0, gate: [NoHorse], affordable_only: true, action: "buy-horse"),
            (label: "Set out on the Trace ▸",       hint: "The long walk home begins.", primary: true, action: "set-out"),
        ]),
        stand: (options: [
            (label: "Rest & resupply — {cost}", hint: "+30 provisions, recover some strength.", cost: 8.0, affordable_only: true, action: "rest"),
            (label: "Trade for a horse — {cost}", hint: "The Chickasaw offer a horse. It earns its keep at the Duck River.", cost: 14.0, gate: [NoHorse, AtStand("buzzard-roost")], affordable_only: true, action: "buy-horse"),
            (label: "🥾 Press on ▸", hint: "", primary: true, action: "leave"),
        ]),
    ),

    endings: [
        (cause: "boat-wrecked",  won: false, message: "Your flatboat broke apart and went down with everything aboard."),
        (cause: "drowned",       won: false, message: "You drowned trying to cross a flooded river on the Trace."),
        (cause: "bandit-murder", won: false, message: "Bandits cut you down on the Trace and took everything."),
        (cause: "disease",       won: false, message: "Fever and exhaustion took you on the long walk home."),
        (cause: "starved",       won: false, message: "Your provisions ran out and you starved in the wilderness."),
        (cause: "lost-in-woods", won: false, message: "Winter caught you still on the Trace, far from Nashville."),
        (cause: "victory",       won: true,  message: "You walked into Nashville with your earnings — a Kaintuck come home rich and alive."),
    ],

    // The branching outcomes of each minigame hazard. Tier is chosen by the host
    // from the minigame result; `drift` (1−accuracy, the sequence miss, or the
    // brigade leak ratio) scales the coefficients. `{cargo_lost}` / `{loss}`
    // interpolate the value taken by a preceding cargo/cash effect.
    outcomes: [
        // --- River steady-hand: holding her off a sandbar ---
        (
            id: "sandbar",
            success: [ Message(text: "You feel her touch the bar and ease her off without losing a thing.") ],
            partial: [
                LoseCargoFraction(base: 0.05, drift_coeff: 0.08, scale_by_draft: true),
                AdjustMorale(-8.0),
                Message(text: "She grinds onto a sandbar — you work her free, but {cargo_lost} of cargo is lost overboard."),
            ],
        ),
        // --- River set-piece: running the Falls of the Ohio ---
        (
            id: "falls-run",
            catastrophe_below: Some(0.15),
            catastrophe: [ Die("boat-wrecked") ],
            success: [
                AdjustReputation(5.0),
                Message(text: "You run the two-mile chute clean as a whistle. Word of it travels downriver ahead of you."),
            ],
            partial: [
                LoseCargoFraction(base: 0.10, drift_coeff: 0.15),
                AdjustMorale(-15.0),
                Message(text: "You scrape the rocks coming through the falls — {cargo_lost} of cargo goes into the river."),
            ],
        ),
        // --- Trace steady-hand: a swamp crossing ---
        (
            id: "swamp",
            success: [ Message(text: "You pick a firm line through the swamp and come out the far side dry.") ],
            partial: [
                AdjustHealth(-10.0),
                AdjustProvisions(-5.0),
                AdjustMiles(base: -5.0),
                Message(text: "The swamp nearly swallows you — you lose ground, provisions, and strength."),
                DieIfDead("disease"),
            ],
        ),
        // --- Trace set-piece: fording the Duck River on foot ---
        (
            id: "duck-ford",
            catastrophe_below: Some(0.2),
            catastrophe_needs_unsteady: true,
            catastrophe: [ Die("drowned") ],
            success: [ Message(text: "You wade the Duck River, holding your footing against the current — wet, but whole.") ],
            partial: [
                AdjustHealth(-10.0),
                AdjustProvisions(-5.0),
                Message(text: "The current nearly takes you crossing the Duck River. You crawl out the far bank half-drowned."),
                DieIfDead("disease"),
            ],
        ),
        // --- River quick-draw: river pirates ---
        (
            id: "pirates",
            success: [
                AdjustReputation(3.0),
                Message(text: "Quick on the trigger — the pirates think better of it and sheer off."),
            ],
            partial: [
                LoseCargoFraction(base: 0.15, halve_if_grouped: true),
                AdjustReputation(-10.0),
                AdjustMorale(-10.0),
                Message(text: "The pirates board you and make off with {cargo_lost} of cargo before you beat them back."),
            ],
            fail: [
                LoseCargoFraction(base: 0.30, halve_if_grouped: true),
                AdjustReputation(-10.0),
                AdjustMorale(-10.0),
                Message(text: "The pirates board you and make off with {cargo_lost} of cargo before you beat them back."),
            ],
        ),
        // --- Trace quick-draw: Sam Mason's gang ---
        (
            id: "mason",
            success: [
                AdjustReputation(5.0),
                Message(text: "You outdraw Mason's man and they melt back into the brush. Few can say as much."),
            ],
            partial: [
                TakeCashFraction(frac: 0.4, frac_grouped: 0.2, set_robbed: true),
                AdjustHealth(-10.0),
                DieIfDead("bandit-murder"),
                Message(text: "Sam Mason's gang robs you of {loss} and leaves you bleeding on the Trace."),
            ],
            fail: [
                TakeCashFraction(frac: 0.4, frac_grouped: 0.2, set_robbed: true),
                AdjustHealth(-15.0),
                DieIfDead("bandit-murder"),
                Message(text: "Sam Mason's gang robs you of {loss} and leaves you bleeding on the Trace."),
            ],
        ),
        // --- Trace quick-draw: the Harpe brothers, north of the divide ---
        (
            id: "harpe",
            success: [
                AdjustReputation(6.0),
                Message(text: "You break away from the Harpes — a thing most men don't live to tell."),
            ],
            partial: [
                TakeCashFraction(frac: 0.6, frac_grouped: 0.3, set_robbed: true),
                AdjustHealth(-15.0),
                DieIfDead("bandit-murder"),
                Message(text: "The Harpe brothers fall on you, take {loss}, and leave you for dead."),
            ],
            fail: [
                TakeCashFraction(frac: 0.6, frac_grouped: 0.3, set_robbed: true),
                AdjustHealth(-20.0),
                DieIfDead("bandit-murder"),
                Message(text: "The Harpe brothers fall on you, take {loss}, and leave you for dead."),
            ],
        ),
        // --- Trace crowd-threading: keeping to the Trace among side trails ---
        (
            id: "side-trail",
            success: [
                AdjustReputation(1.0),
                Message(text: "You keep the Trace clear in your mind and make good time through the tangle of side trails."),
            ],
            fail: [
                AdjustMiles(base: -8.0, drift_coeff: -20.0),
                AdjustProvisions(-6.0),
                Message(text: "You lose the Trace on a side trail and waste a day doubling back."),
            ],
        ),
        // --- Trace timing-bar: dosing the swamp fever ---
        (
            id: "dose",
            success: [ Message(text: "You measure the dose right and sweat the fever out by morning.") ],
            fail: [
                AdjustHealth(-10.0),
                Message(text: "The fever burns through you — you can barely keep your feet."),
                DieIfDead("disease"),
            ],
        ),
        // --- River sequence: patching a snagged hull ---
        (
            id: "patch",
            success: [ Message(text: "Wedge, oakum, plank — you patch the hole in good order before much water gets in.") ],
            partial: [
                LoseCargoFraction(base: 0.05, drift_coeff: 0.15),
                AdjustMorale(-8.0),
                Message(text: "You fumble the patch and she ships water — {cargo_lost} of cargo is ruined before you stop the leak."),
            ],
        ),
        // --- River bucket-brigade: bailing a flooded boat ---
        (
            id: "bail",
            success: [
                LoseCargoFraction(base: 0.03),
                Message(text: "You bail her out ahead of the rising water — only {cargo_lost} of cargo lost."),
            ],
            fail: [
                LoseCargoFraction(base: 0.08, drift_coeff: 0.25),
                AdjustMorale(-10.0),
                Message(text: "The flood gets ahead of you — {cargo_lost} of cargo is soaked and lost over the side."),
            ],
        ),
    ],

    // The launch parameters for each minigame, fed straight into its component.
    // "gamble" is here too — its outcome is hand-coded, but its timing bar is data.
    minigames: [
        (id: "sandbar",    params: Steady(prompt: "Sandbar ahead — hold her off the bar with the steering oar.",              tolerance: 0.13, duration_ms: 6000, drift_speed: 1.2)),
        (id: "falls-run",  params: Steady(prompt: "The Falls of the Ohio! Run the chute — hold your line through the rapids.", tolerance: 0.10, duration_ms: 7000, drift_speed: 1.6)),
        (id: "swamp",      params: Steady(prompt: "A flooded swamp crossing — keep your footing on the firm ground.",         tolerance: 0.13, duration_ms: 6000, drift_speed: 1.3)),
        (id: "duck-ford",  params: Steady(prompt: "Fording the Duck River on foot — hold against the current.",              tolerance: 0.11, duration_ms: 6500, drift_speed: 1.5)),
        (id: "pirates",    params: Quick(prompt: "River pirates pull alongside — draw!",        words: ["FIRE", "DRAW", "BANG", "CRACK"])),
        (id: "mason",      params: Quick(prompt: "Sam Mason's men step out of the brush — draw!", words: ["FIRE", "DRAW", "BANG", "CRACK"])),
        (id: "harpe",      params: Quick(prompt: "The Harpe brothers are on you — DRAW, fast!",   words: ["FIRE", "DRAW", "BANG", "CRACK"])),
        (id: "side-trail", params: Crowd(prompt: "The Trace forks into a dozen side trails. Fix the way north in your mind.", crowd_size: 11, member_icon: "🌲", player_icon: "@", exit_icon: ">", reveal_ms: 2800, navigate_ms: 11000)),
        (id: "dose",       params: Timing(prompt: "Swamp fever. Measure out the dose — too much or too little does no good.", action: "POUR",    tolerance: 0.12, period_ms: 1500)),
        (id: "gamble",     params: Timing(prompt: "Under-the-Hill — lay your stake and call it as the wheel comes round.",    action: "CALL IT", tolerance: 0.10, period_ms: 1300)),
        (id: "patch",      params: Sequence(prompt: "A snag punches a hole in the hull — patch it in order before she fills.", symbols: ["🪵", "🧵", "🔨", "🪣"], length: 4)),
        (id: "bail",       params: Brigade(prompt: "High water floods the boat — bail her out faster than she fills!", threat_icon: "💧", cols: 5, rows: 5, initial_active: 3, spread_ms: 750, duration_ms: 8000)),
    ],

    // Ambient crew banter, played on quiet (clean) legs instead of the flat
    // "quiet stretch" line. Pools are keyed by region (phase + milepost band);
    // river position is the leg's origin landing, Trace position is miles walked.
    // Each beat plays at most once. Authoring: lead with the questioner/expert
    // device — a green hand asks, an old hand explains — keep beats to 2-4 short
    // lines, and keep the history period-true (early-1800s flatboat trade and the
    // Natchez Trace walk home). Voices are free text that prefixes the line.
    banter: [
        // ----- Upper Ohio: Pittsburgh and Wheeling, settling into the run -----
        (
            phase: River, from_mile: 0.0, to_mile: 470.0,
            beats: [
                (
                    key: "upper-ohio-current",
                    lines: [
                        (voice: "The farmhand squints downriver:", text: "We just ride it the whole way down?"),
                        (voice: "The old riverman spits over the side:", text: "The Ohio does the work clear to its mouth. Easy water — bars and snags, mostly. Save your worry for the Mississippi."),
                    ],
                ),
                (
                    key: "upper-ohio-trade",
                    lines: [
                        (voice: "The boatwright thumps the gunwale:", text: "Whiskey, flour, salt pork — worth three times at Natchez what it fetched in Pittsburgh. Float it down, sell it high, break the boat up for lumber. That's the whole game."),
                    ],
                ),
                (
                    key: "the-fiddler",
                    lines: [
                        (voice: "The farmhand nods at the old man sawing a fiddle at the bow:", text: "Does he pull an oar like the rest of us, or just play?"),
                        (voice: "The old riverman grins:", text: "Pappy? First man in the water when she grounds on a bar, and he fiddles the whole night watch besides. Brought nothing aboard but his violin and Katy and his plunder. Worth two hands for the singing alone."),
                    ],
                ),
                (
                    key: "rowing-song",
                    lines: [
                        (voice: "The crew settles into a stroke, and a song goes up to keep the time:", text: "\"Some rows up, but we rows down — all the way to Shawnee town — pull away, pull away!\""),
                    ],
                ),
                (
                    key: "marietta-yard",
                    lines: [
                        (voice: "The boatwright jerks a thumb at a riverside town of saw-pits and ways:", text: "Marietta yonder builds seagoing ships — rigged brigs at fifty dollar a ton — and floats 'em clear down to the ocean. Our flatboat won't ever see salt water. She's a pile of lumber the day we tie up at Natchez."),
                    ],
                ),
            ],
        ),
        // ----- Lower Ohio: the Falls, and the wreckers' cave -----
        (
            phase: River, from_mile: 470.0, to_mile: 980.0,
            beats: [
                (
                    key: "the-falls",
                    lines: [
                        (voice: "The boatwright nods downstream:", text: "Below Louisville the river drops over the Falls of the Ohio — two mile of bare rock. Hire a pilot or wait on high water. The ones who run it blind feed the catfish."),
                    ],
                ),
                (
                    key: "cave-in-rock",
                    lines: [
                        (voice: "The farmhand points at a black gash in the bluffs:", text: "What's that cave yonder?"),
                        (voice: "The old riverman doesn't look up:", text: "Cave-in-Rock. River pirates laired there — hung out a sign for liquor to lure boats ashore, then took the cargo and sank the rest. Keep to the channel. Don't put in, no matter who waves you down."),
                    ],
                ),
                (
                    key: "the-hail",
                    lines: [
                        (voice: "A boat sweeps past and a man cups his hands across the water:", text: "\"Where you from? What's your lading? Who's your captain? Where you bound?\""),
                        (voice: "The old riverman bawls back without missing a beat:", text: "\"Redstone! Millstones! Whetstone! — Limestone!\" Same four hollers, every boat on the river. Quick with the answer or you're the joke of the reach."),
                    ],
                ),
                (
                    key: "blackguarding",
                    lines: [
                        (voice: "Two boats drift in earshot and the crews start trading insults across the gap:", text: "Whooping, hollering, every man straining to outdo the last."),
                        (voice: "The old riverman, cheerful:", text: "Blackguardin', we call it. Whoever leaves the other fellow with nothing left to say is the hero of the day. The one who runs dry is his crew's joke for a week. It's all wind — mostly."),
                    ],
                ),
                (
                    key: "the-horn",
                    lines: [
                        (voice: "The farmhand startles at a low, mournful note rolling over the water:", text: "What in creation was that?"),
                        (voice: "The old riverman:", text: "Boat horn. Sound it in fog so the next fellow don't run you down — and they say it scares off the devil and brings fair luck besides. Can't hurt. Wind it again, boy."),
                    ],
                ),
                (
                    key: "shore-dance",
                    lines: [
                        (voice: "Tied up by a settler's cabin, a fiddle strikes up and the men stamp out the time:", text: "\"Dance, boatman, dance — dance all night till broad daylight — and go home with the gals in the morning!\""),
                    ],
                ),
            ],
        ),
        // ----- The Mississippi: Cairo down to Natchez, the dangerous water -----
        (
            phase: River, from_mile: 980.0, to_mile: 1830.0,
            beats: [
                // Surly-crew variant first: only fires when morale has worn thin,
                // else it's skipped and the next beat plays.
                (
                    key: "mississippi-grumble",
                    gates: [MoraleBelow(50.0)],
                    lines: [
                        (voice: "A hand mutters at his oar:", text: "Triple pay at Natchez, he keeps saying. If we live to count it."),
                    ],
                ),
                (
                    key: "big-muddy",
                    lines: [
                        (voice: "The farmhand:", text: "Lord — the river's near a mile across now."),
                        (voice: "The old riverman:", text: "That's the Mississippi. Swallowed the Ohio back at Cairo. Runs faster, hides more — and the men who work these banks ain't all honest."),
                    ],
                ),
                (
                    key: "natchez-under-the-hill",
                    lines: [
                        (voice: "The old riverman lowers his voice:", text: "Natchez sits proud on the bluff, but the landing under it — Natchez-under-the-Hill — is all grog, cards, and cut throats. Sell your cargo up top. Men have lost the whole trip down below."),
                    ],
                ),
                (
                    key: "river-names",
                    lines: [
                        (voice: "The old riverman reads the water like a page, naming every snarl as it slides past:", text: "Yonder's the Devil's Elbow — worst bend on the river. That cluster of islands is Paddy's Hen and Chickens. That long bar's General Hull's Left Leg. Every reach has its name, and knowing 'em is half of staying afloat."),
                    ],
                ),
                (
                    key: "night-camp",
                    lines: [
                        (voice: "You tie up at dusk and the boy slaps at the air:", text: "These skeeters mean to carry me clean off."),
                        (voice: "The old riverman heaps green wood on a smudge fire:", text: "Smudge'll hold 'em back. Eat your ration, then it's cards or a coon hunt or a yarn till the fire dies down. Sleep on the bank — or atop the cargo if it comes on to rain. We're off again at first light."),
                    ],
                ),
                (
                    key: "boatman-song",
                    gates: [MoraleAbove(60.0)],
                    lines: [
                        (voice: "Late, with the jug going round the deck, the old song starts up of its own accord:", text: "\"The boatman is a lucky man, no one can do as the boatman can... Hi-O, away we go, floating down the river on the O-hi-o!\""),
                    ],
                ),
                (
                    key: "french-song",
                    lines: [
                        (voice: "A barge of Creole boatmen sweeps past, the steersman calling a line and the crew answering it back:", text: "\"L'on, ton, laridon, danée... L'on, ton, laridon, dai!\""),
                        (voice: "The old riverman listens a moment:", text: "French rivermen. Better singers than us by a country mile — sing the whole day to keep their minds off the work and the wild country. Half don't know what the words mean. Don't seem to matter."),
                    ],
                ),
            ],
        ),
        // ----- The Trace, before the divide: why you walk, and whose land it is -----
        (
            phase: Trace, from_mile: 0.0, to_mile: 423.9,
            beats: [
                (
                    key: "why-walk",
                    lines: [
                        (voice: "The boy shifts his pack:", text: "Why walk? We had a good boat."),
                        (voice: "The old trace-walker:", text: "Can't pole a flatboat back up two thousand mile of current, son. Everybody walks the Trace home — five hundred mile of woods, Natchez to Nashville."),
                    ],
                ),
                (
                    key: "the-stands",
                    lines: [
                        (voice: "The old trace-walker:", text: "These inns — the stands — most are kept by Chickasaw and Choctaw on their own land. A meal, a roof, and you're safe while you're under it. Mind your manners. We're guests the whole way north."),
                    ],
                ),
            ],
        ),
        // ----- Past the divide: Harpe country -----
        (
            phase: Trace, from_mile: 423.9, to_mile: 1000.0,
            beats: [
                (
                    key: "harpe-country",
                    lines: [
                        (voice: "The boy:", text: "You've gone quiet since that last ridge."),
                        (voice: "The old trace-walker keeps his voice low:", text: "Past the divide now. The Harpes worked this stretch — meanest cutthroats the Trace ever bred. They're dead and gone. Their kind never quite is. Walk close, and don't straggle once it's dark."),
                    ],
                ),
            ],
        ),
    ],
)
